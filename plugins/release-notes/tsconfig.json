{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@philo/plugin": [
        "./.philo-types/plugin.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    ".philo-types/*.d.ts"
  ]
}
